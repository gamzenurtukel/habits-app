{
  "expo": {
    "name": "habits-app",
    "slug": "habits-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/habitz_logo.png",
    "scheme": "habitzapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/habitz_logo.png",
      "supportsTablet": true,
      "CFBundleAllowMixedLocalizations": true,
      "bundleIdentifier": "com.habitzpro.habittracker",
      "teamID": "CX7WP93J6C",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Bildirimler alarak uygulama deneyiminizi geliştirebilirsiniz."
      },
      "config": {
        "usesAppleSignIn": true,
        "googleSignIn": {
          "reservedClientId": "com.googleusercontent.apps.218999374494-uukisnfh3eal4p45kj1ak29cdda3divl"
        }
      }
    },
    "android": {
      "package": "com.habitzpro.habittracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "habitz.pro",
              "pathPrefix": "/"
            }
          ],
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/habitz_logo.png",
          "imageWidth": "100%",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.218999374494-uukisnfh3eal4p45kj1ak29cdda3divl"
        }
      ],
      ["expo-apple-authentication"],
      "expo-font",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "03b04d50-ae14-4692-bc59-3e1f74974342"
      }
    }
  }
}
