{
  "expo": {
    "name": "habits-app",
    "slug": "habits-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habitzapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "CFBundleAllowMixedLocalizations": true,
      "bundleIdentifier": "com.habitzpro.habittracker",
      "associatedDomains": [
        "applinks:habitz.pro"
      ],
      "teamID": "CX7WP93J6C"
    },
    "android": {
      "package": "com.habitzpro.habittracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "habitz.pro",
              "pathPrefix": "/"
            }
          ],
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "03b04d50-ae14-4692-bc59-3e1f74974342"
      }
    }
  }
}
